{
  "name": "static-site-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets an agent manage one statically generated (or plain static) website: pages, files, builds and publishing.",
  "type": "module",
  "bin": { "static-site-mcp": "dist/cli.js" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts serve",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "^5.1.0",
    "gray-matter": "^4.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
